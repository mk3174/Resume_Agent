# Copy this file to .env and fill in real values. .env is gitignored.

# ---- LLM providers ----
# Local Ollama (default). Override host if Ollama runs on a remote Mac mini.
OLLAMA_HOST=http://localhost:11434

# Optional external providers (only used if settings.yaml -> tailor.mode = single_call
# AND llm.router escalates to external).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Telegram (Phase 0+) ----
# Create a bot with @BotFather, then start a chat with it and run
# `uv run resume-agent telegram-chat-id` to discover your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Optional: residential proxy for Indeed/LinkedIn (Phase 4) ----
PROXY_URL=
